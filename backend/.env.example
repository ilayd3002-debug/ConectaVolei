# Porta do servidor Express
PORT=3000

# Banco SQLite (Prisma). O arquivo é criado em backend/prisma/dev.db
DATABASE_URL="file:./dev.db"

# Chave secreta para gerar o token JWT (troque por um valor forte)
JWT_SECRET=troque_esta_chave_secreta
JWT_EXPIRES_IN=8h

# Recuperação de senha por e-mail (Brevo) - opcional
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# FRONT_URL=http://localhost:5173
